NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API Keys -> secret key. Server-side only, bypasses RLS - never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Protects the reminder cron endpoint from being called by anyone else.
CRON_SECRET=

# console.anthropic.com -> API Keys. Powers the in-app assistant.
ANTHROPIC_API_KEY=
